# ---------------------------------------------------------------------------
# Supabase  (required)
#
# Dashboard -> Project Settings -> API Keys.
#
# Supabase renamed its keys. Map what you see in the dashboard like this:
#
#   Project URL      -> NEXT_PUBLIC_SUPABASE_URL
#   Publishable key  -> NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY   (sb_publishable_...)
#   Secret key       -> SUPABASE_SECRET_KEY                    (sb_secret_...)
#
# Older projects show "anon" and "service_role" instead. Those still work --
# the code accepts NEXT_PUBLIC_SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY
# as fallbacks. Set one key per row, not both.
#
# The JWKS URL is NOT needed. It is for verifying end-user JWTs, and
# RunwayCourt has no user login -- the agent is the only writer.
#
# SUPABASE_SECRET_KEY bypasses Row Level Security. It has no NEXT_PUBLIC_
# prefix on purpose: never expose it to the browser or commit it.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Chain layer
#
#   simulator  (default) -- runway is derived from the live file inventory and
#                           real elapsed time. No wallet needed.
#   synapse              -- read real runway from Filecoin Pay via @filoz/synapse-sdk.
# ---------------------------------------------------------------------------
RUNWAYCOURT_CHAIN=simulator

# ---------------------------------------------------------------------------
# Filecoin  (only when RUNWAYCOURT_CHAIN=synapse)
#
# Use a throwaway testnet key. Fund it with tFIL and tUSDFC from the Calibration
# faucet before running.
# ---------------------------------------------------------------------------
FILECOIN_NETWORK=calibration

# Optional: defaults to the chain's public RPC.
# FILECOIN_RPC_URL=https://api.calibration.node.glif.io/rpc/v1

# Watch an account read-only -- enough for live vitals, no key needed.
# FILECOIN_ADDRESS=0xyour-wallet-address

# Required only to SUBMIT verdicts (terminateService on DROP).
# Use a throwaway testnet key. Never commit this.
# FILECOIN_PRIVATE_KEY=0xyour-testnet-private-key

# ---------------------------------------------------------------------------
# Delegated authority  (required for multi-user mode)
#
# Each user's agent signer is DERIVED from this secret plus their user id, so no
# key material is ever stored in the database. Rotating it invalidates every
# delegation at once.
#
#   openssl rand -hex 32
#
# Whoever holds this can act for any user whose grant is still live. Keep it out
# of the repo.
# ---------------------------------------------------------------------------
RUNWAYCOURT_SESSION_SECRET=

# Only for scripts/upload-filecoin.ts -- which user's court owns a CLI upload.
# Find it in Supabase -> Authentication -> Users.
# RUNWAYCOURT_USER_ID=
